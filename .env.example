# Environment Variables for Blog

# Set to 'true' to show draft posts in development mode
# In production, drafts are always hidden regardless of this setting
# Note: This is used during build time, so no PUBLIC_ prefix is needed
SHOW_DRAFTS=false

# PostHog analytics
# Public project token from PostHog → Project settings
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
# PostHog ingestion host for this project
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
