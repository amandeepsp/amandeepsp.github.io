---
import sharp from "sharp";
import path from "node:path";

interface Props {
    src: string;
    alt: string;
    width?: string;
}

const { src, alt, width } = Astro.props;
const hasCaption = Astro.slots.has("caption");
const dimensions = await sharp(path.join(process.cwd(), "public", src)).metadata();
---

<figure class="media-figure">
    <img
        src={src}
        alt={alt}
        width={dimensions.width}
        height={dimensions.height}
        loading="lazy"
        decoding="async"
        class="media-figure-image"
        style={width ? `width: ${width}` : undefined}
    />
    {
        hasCaption && (
            <figcaption class="media-caption">
                <slot name="caption" />
            </figcaption>
        )
    }
</figure>
