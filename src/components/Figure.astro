---
interface Props {
    src: string;
    alt: string;
    width?: string;
}

const { src, alt, width } = Astro.props;
const hasCaption = Astro.slots.has("caption");
---

<figure class="media-figure">
    <img src={src} alt={alt} class="media-figure-image" style={width ? `width: ${width}` : undefined} />
    {
        hasCaption && (
            <figcaption class="media-caption">
                <slot name="caption" />
            </figcaption>
        )
    }
</figure>
