---
import siteConfig from "../data/site-config";

const socialLinks = siteConfig.socialLinks || [];
---

<footer class="site-footer">
    <div class:list={["site-footer-inner", { "has-social-links": socialLinks.length > 0 }]}>
        {
            socialLinks.length > 0 && (
                <div class="social-links">
                    {socialLinks.map((link) => (
                        <a class="footer-link" href={link.href} target="_blank" rel="noopener noreferrer">
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
        <p class="copyright">
            &copy; {new Date().getFullYear()}&nbsp;<a class="footer-link" href="/">{siteConfig.title}</a>. All rights
            reserved.
        </p>
    </div>
</footer>
