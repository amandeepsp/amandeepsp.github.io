---
import IconButton from "./IconButton.astro";

const { page, class: className } = Astro.props;
---

<nav aria-label="Pagination" class:list={["pagination", className]}>
    {
        page.url.prev && (
            <IconButton
                class="pagination-previous"
                href={page.url.prev}
                aria-label={`Go to page ${page.currentPage - 1} of ${page.lastPage}`}
            >
                ←
            </IconButton>
        )
    }
    <span class="pagination-status" aria-current="page">Page {page.currentPage} of {page.lastPage}</span>
    {
        page.url.next && (
            <IconButton
                class="pagination-next"
                href={page.url.next}
                aria-label={`Go to page ${page.currentPage + 1} of ${page.lastPage}`}
            >
                →
            </IconButton>
        )
    }
</nav>
