---
import { type CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

type Props = { post: CollectionEntry<"blog">; class?: string; headingLevel?: "h2" | "h3"; showFeatured?: boolean };

const { post, class: className, headingLevel = "h2", showFeatured = false } = Astro.props;
const { title, subTitle, publishDate, updatedDate, featured } = post.data;
const TitleTag = headingLevel;
---

<a class:list={["post-preview", className]} href={`/blog/${post.id}/`}>
    <div class="post-preview-content">
        <TitleTag class="post-preview-title">
            {title}
            {
                showFeatured && featured && (
                    <span class="featured-mark" title="Featured">
                        ★
                    </span>
                )
            }
        </TitleTag>
        {subTitle && <p class="post-preview-subtitle">{subTitle}</p>}
        <div class="post-preview-date">
            <FormattedDate date={publishDate} />
            {
                updatedDate && (
                    <>
                        {" "}
                        <span>
                            (Updated on <FormattedDate date={updatedDate} />)
                        </span>
                    </>
                )
            }
        </div>
        <!-- {excerpt && <div class="mt-3 text-sm leading-normal">{excerpt}</div>} -->
    </div>
    <div class="post-preview-prompt">Read Post →</div>
</a>
