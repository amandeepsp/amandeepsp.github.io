---

<button id="theme-toggle" type="button" class="theme-toggle" aria-label="Use dark theme" aria-pressed="false">
    <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.75"></circle>
        <path
            d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.28 5.28l1.42 1.42M17.3 17.3l1.42 1.42M18.72 5.28 17.3 6.7M6.7 17.3l-1.42 1.42"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"></path>
    </svg>
    <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
            d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"></path>
    </svg>
</button>

<script>
    function getTheme() {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light" || savedTheme === "dark") return savedTheme;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function applyTheme(theme: "light" | "dark") {
        const isDark = theme === "dark";
        document.documentElement.classList.toggle("dark", isDark);

        const toggle = document.getElementById("theme-toggle");
        toggle?.setAttribute("aria-pressed", String(isDark));
        toggle?.setAttribute("aria-label", isDark ? "Use light theme" : "Use dark theme");
    }

    function initThemeToggle() {
        applyTheme(getTheme());

        document.getElementById("theme-toggle")?.addEventListener("click", () => {
            const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
            localStorage.setItem("theme", nextTheme);
            applyTheme(nextTheme);
        });
    }

    initThemeToggle();
</script>
