---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import PostPreview from "../../components/PostPreview.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Sidenotes from "../../components/Sidenotes.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import { sortItemsByDateDesc, calculateReadingTime, filterDrafts, getSeriesPosts } from "../../utils/data-utils";
import { slugify } from "../../utils/common-utils";
import "remark-github-blockquote-alert/alert.css";

export async function getStaticPaths() {
    const posts = filterDrafts(await getCollection("blog")).sort(sortItemsByDateDesc);
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            relatedPosts: posts
                .map((candidate, candidateIndex) => ({
                    post: candidate,
                    sameSeries: Boolean(post.data.series && candidate.data.series?.name === post.data.series.name),
                    sharedTags: (candidate.data.tags ?? []).filter((tag) => (post.data.tags ?? []).includes(tag))
                        .length,
                    distance: Math.abs(candidateIndex - index)
                }))
                .filter((candidate) => candidate.post.id !== post.id)
                .sort(
                    (a, b) =>
                        Number(b.sameSeries) - Number(a.sameSeries) ||
                        b.sharedTags - a.sharedTags ||
                        a.distance - b.distance
                )
                .slice(0, 2)
                .map((candidate) => candidate.post)
        }
    }));
}

type Props = { post: CollectionEntry<"blog">; relatedPosts: CollectionEntry<"blog">[] };

const { href } = Astro.url;
const { post, relatedPosts } = Astro.props;
const { title, subTitle, publishDate, updatedDate, excerpt, tags = [], toc, series, seo } = post.data;
const { Content, headings } = await render(post);

const postKeywords = seo?.keywords?.length ? seo.keywords : tags;

// Calculate reading time from the post content
const readingTime = calculateReadingTime(post.body);

// Get series posts if this post belongs to a series
const allPosts = filterDrafts(await getCollection("blog"));
const seriesPosts = series ? getSeriesPosts(series.name, allPosts) : [];
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    image={seo?.image}
    pageType="article"
    publishDate={publishDate}
    updatedDate={updatedDate}
    tags={tags}
    keywords={postKeywords}
    readingTime={readingTime}
    noindex={seo?.noindex ?? false}
>
    <ReadingProgress />
    <Sidenotes />
    <div class:list={["article-layout", { "article-layout--with-toc": toc }]}>
        {toc && <TableOfContents headings={headings} />}
        <article class="post">
            <header class="post-header">
                <h1 class="post-title">{title}</h1>
                {subTitle && <p class="post-subtitle">{subTitle}</p>}
                {
                    series && seriesPosts.length > 1 && (
                        <SeriesNav seriesName={series.name} posts={seriesPosts} currentPostId={post.id} />
                    )
                }
                <div class="post-meta">
                    <div class="post-meta-row">
                        <FormattedDate date={publishDate} />
                        <span class="post-meta-separator">&middot;</span>
                        <span>{readingTime}</span>
                    </div>
                    {
                        updatedDate && (
                            <div class="post-updated">
                                Updated <FormattedDate date={updatedDate} />
                            </div>
                        )
                    }
                    {
                        tags.length > 0 && (
                            <div class="post-tags">
                                {tags.map((tag) => (
                                    <a class="post-tag" href={`/tags/${slugify(tag)}/`}>
                                        #{tag}
                                    </a>
                                ))}
                            </div>
                        )
                    }
                </div>
                {toc && <TableOfContents headings={headings} mobile />}
            </header>
            <div class="post-ornament" aria-hidden="true">
                <span class="post-ornament-mark"></span>
            </div>
            <div class="post-content prose-blog">
                <Content />
            </div>
            <div class="post-end-ornament" aria-hidden="true"></div>
            <div class="post-share">
                <img src="/wax-seal.webp" alt="" width="64" height="64" loading="lazy" decoding="async" />
                <Button
                    class="copy-url-button"
                    aria-label="Copy link"
                    data-url={href}
                    data-tooltip-default="Copy link"
                    data-tooltip-success="Copied">Share</Button
                >
            </div>
        </article>
    </div>
    {
        relatedPosts.length > 0 && (
            <section class="read-next">
                <h2 class="read-next-title">Read Next</h2>
                <div class="post-list post-list--wide">
                    {relatedPosts.map((relatedPost) => (
                        <PostPreview post={relatedPost} headingLevel="h3" />
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>

<script>
    function initCopyLink() {
        const copyUrlButton = document.querySelector(".copy-url-button") as HTMLButtonElement;
        copyUrlButton?.addEventListener("click", async () => {
            await copyUrl(copyUrlButton);
        });

        async function copyUrl(button: HTMLButtonElement) {
            let url = button.getAttribute("data-url") || "";
            const label = button.innerText;

            await navigator.clipboard.writeText(url);

            button.innerText = "Copied";

            setTimeout(() => {
                button.innerText = label;
            }, 2500);
        }
    }

    initCopyLink();
</script>
