---
import BaseLayout from "../layouts/BaseLayout.astro";

const socialLinks = [
    {
        label: "Connect on LinkedIn",
        href: "https://linkedin.com/in/amandeepsp",
        icon: "linkedin"
    },
    {
        label: "Follow on X",
        href: "https://x.com/theamndeepsingh",
        icon: "x"
    },
    {
        label: "Browse my code on GitHub",
        href: "https://github.com/amandeepsp",
        icon: "github"
    }
];
---

<BaseLayout title="Contact Me" description="Get in touch with me" pageType="website" noindex={false}>
    <div class="contact-page">
        <h1 class="page-title contact-title">Get in Touch</h1>
        <p class="contact-intro">
            Whether it's a question about something I've written, an interesting project or collaboration, or just a
            conversation about systems and software &mdash; I'm always happy to hear from you.
        </p>

        <div class="contact-sections">
            <section>
                <h2 class="contact-section-title">Email</h2>
                <a class="contact-email" data-contact-email aria-label="Email address"></a>
                <noscript>Email address requires JavaScript.</noscript>
            </section>

            <section>
                <h2 class="contact-section-title">Elsewhere</h2>
                <ul class="contact-links">
                    {
                        socialLinks.map((link) => (
                            <li>
                                <a href={link.href} target="_blank" rel="noopener noreferrer" class="contact-link">
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </div>
    </div>
</BaseLayout>

<script>
    const emailLink = document.querySelector("[data-contact-email]");
    const emailCodePoints = [
        97, 109, 97, 110, 100, 101, 101, 112, 115, 112, 100, 104, 114, 64, 103, 109, 97, 105, 108, 46, 99, 111, 109
    ];

    if (emailLink instanceof HTMLAnchorElement) {
        const address = String.fromCodePoint(...emailCodePoints);
        emailLink.textContent = address;
        emailLink.href = `mailto:${address}`;
    }
</script>
