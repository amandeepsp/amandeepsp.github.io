---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostPreview from "../../components/PostPreview.astro";
import { filterDrafts, getAllSeries } from "../../utils/data-utils";

const posts = filterDrafts(await getCollection("blog"));
const series = getAllSeries(posts);
---

<BaseLayout
    title="Series"
    description="Browse connected series of articles, ordered from first part to last."
    pageType="website"
    noindex={false}
>
    <h1 class="page-title">Series</h1>
    {
        series.length > 0 ? (
            series.map(({ name, posts }) => (
                <section class="series-group">
                    <div class="series-heading">
                        <h2 class="series-title">{name}</h2>
                        <p class="series-count">
                            {posts.length} {posts.length === 1 ? "part" : "parts"}
                        </p>
                    </div>
                    <div class="post-list">
                        {posts.map((post) => (
                            <PostPreview post={post} headingLevel="h3" />
                        ))}
                    </div>
                </section>
            ))
        ) : (
            <p class="muted">No published series yet.</p>
        )
    }
</BaseLayout>
